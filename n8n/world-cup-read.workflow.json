    {
      "parameters": {
        "jsCode": "// Bundle the four live tabs into one raw response.\n// The draw page does its own filtering/animation from this data,\n// so we keep this node \"dumb\" — just pass the rows through.\n// `row_number` (added automatically by the Google Sheets node) is\n// preserved so the write workflow can target the exact row.\nconst rows = (name) => $(name).all().map((item) => item.json);\n\nreturn [\n  {\n    json: {\n      group1: rows('Read Group 1'),\n      group2: rows('Read Group 2'),\n      allTeams: rows('Read All Teams'),\n      teamCodes: rows('Read Team Codes')\n    }\n  }\n];"
      },
